# ─────────────────────────────────────────────────────────────────────────────
# VigiShield AI Backend — Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ASP.NET Core backend URL
BACKEND_API_URL=http://localhost:5020

# Internal API key (must match InternalApi:Key in appsettings.Development.json)
INTERNAL_API_KEY=dev-internal-api-key-12345

# UUID of the household this AI instance monitors
# Find it in the database or from the /api/auth/me response (householdId field)
HOUSEHOLD_ID=your-household-uuid-here

# ── Stream source ────────────────────────────────────────────────────────────
# Leave blank to fetch the RTSP URL from the backend automatically.
# Set this to override and use a fixed RTSP URL regardless of backend config.
# RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream

# ── For RTMP Relay mode (Option B) ──────────────────────────────────────────
# The Python backend reads RTSP directly from the camera even in relay mode,
# since the camera is on the same local network.
# If you want Python to read from a local MediaMTX instead:
# RTSP_URL=rtsp://localhost:8554/live/your-stream-key

# ── Processing tuning ────────────────────────────────────────────────────────
# How often to read & process a frame (seconds)
FRAME_INTERVAL_SECONDS=5

# How often to emit a simulated event (seconds) — used only in stub mode
EVENT_SIMULATION_INTERVAL_SECONDS=30

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
